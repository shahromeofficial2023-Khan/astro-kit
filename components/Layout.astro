---
/**
 * The page shell every fleet tool site shares: SEO head, brand colours from site.json, skip link,
 * header, footer with the site's disclaimer. Pages supply only their content.
 *   <Layout title description path>  ·  slots: head, logo, header-tools, default, after-main, footer
 *   `footer` replaces the default one-line footer; `after-main` sits between main and footer (back-to-top etc.).
 *   site.json theme "toggle" adds a dark-mode button to the header (light for everyone until pressed; choice kept
 *   in localStorage and applied before first paint). `themeLabel` names it in the page's language.
 */
import '../styles/base.css';
import Head, { type Alternate } from './Head.astro';
import site from 'virtual:fleet-site';
import { tokensCss, isNoindexPath } from '../index.mjs';

interface Props {
  title: string; description: string; path: string;
  ogImage?: string; lang?: string; dir?: 'ltr' | 'rtl'; ogLocale?: string; robots?: string;
  alternates?: Alternate[]; xDefault?: string; ogLocaleAlternates?: string[];   // multilingual pages
  fontHref?: string;      // a Google Fonts stylesheet URL loaded only on this page (e.g. an Arabic face)
  bodyClass?: string;
  themeLabel?: string;    // accessible name of the dark-mode button (theme "toggle"), in the page's language
}
const { title, description, path, ogImage, lang = 'en', dir = 'ltr', ogLocale = 'en_US', robots,
  alternates = [], xDefault, ogLocaleAlternates = [], fontHref, bodyClass, themeLabel = 'Dark mode' } = Astro.props;
// a page listed in site.json "noindex" (exact or "/prefix/*") is noindex,follow unless it sets robots itself
const robotsValue = robots ?? (isNoindexPath(site, path) ? 'noindex, follow' : undefined);
const tokens = site.brand_tokens;
const toggle = site.theme === 'toggle' && !!tokens?.dark;
const css = tokensCss(tokens, site.theme);
const darkHeader = tokens?.dark?.header ?? tokens?.light?.header;
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <Head title={title} description={description} path={path} siteName={site.name}
    ogLocale={ogLocale} ogImage={ogImage} themeColor={tokens?.light?.header} robots={robotsValue}
    alternates={alternates} xDefault={xDefault} ogLocaleAlternates={ogLocaleAlternates}
    author={site.owner?.name} rss={site.rss ? '/rss.xml' : undefined} />
  {fontHref && <><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link rel="stylesheet" href={fontHref} /></>}
  {css && <style is:inline set:html={css} />}
  {toggle && <script is:inline set:html={`try{var t=localStorage.getItem('theme');if(t==='dark')document.documentElement.dataset.theme='dark'}catch(e){}`} />}
  {site.analytics && /^G-[A-Z0-9]+$/.test(site.analytics) && <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics}`}></script>
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${site.analytics}');`} />
  </>}
  <slot name="head" />
</head>
<body class={bodyClass}>
<a class="skip" href="#main"><slot name="skip">Skip to content</slot></a>
<header class="site"><div class="wrap">
  <a class="brand" href="/">
    <slot name="logo"><img src="/favicon.svg" alt="" width="30" height="30" /></slot>
    {site.name}
  </a>
  <div class="header-tools">
    <slot name="header-tools" />
    {toggle && <button type="button" class="theme-btn" data-theme-toggle aria-pressed="false" aria-label={themeLabel} title={themeLabel}>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
    </button>}
  </div>
</div></header>
<main id="main"><slot /></main>
<slot name="after-main" />
<slot name="footer">
<footer><div class="wrap">
  {site.disclaimer && <p><strong>{site.name}</strong> {site.disclaimer}</p>}
</div></footer>
</slot>
{toggle && <script is:inline set:html={`(function(){var b=document.querySelector('[data-theme-toggle]'),r=document.documentElement,m=document.querySelector('meta[name=theme-color]');if(!b)return;function sync(){var d=r.dataset.theme==='dark';b.setAttribute('aria-pressed',d?'true':'false');if(m)m.content=d?${JSON.stringify(darkHeader ?? '')}:${JSON.stringify(tokens?.light?.header ?? '')}}b.addEventListener('click',function(){r.dataset.theme=r.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}sync()});sync()})();`} />}
</body>
</html>
