---
/** Author / owner identity: Person JSON-LD (+ optional visible bio card). sameAs = the profile URLs (RankMath "Person" schema). */
import JsonLd from './JsonLd.astro';
interface Props { name: string; url?: string; description?: string; jobTitle?: string; image?: string; sameAs?: string[]; email?: string; id?: string; card?: boolean }
const { name, url, description, jobTitle, image, sameAs = [], email, id, card = false } = Astro.props;
const abs = (u?: string) => (u ? new URL(u, Astro.site).href : undefined);
const graph = [{ '@type': 'Person', ...(id ? { '@id': abs(id) } : {}), name, url: abs(url), description, jobTitle,
  ...(image ? { image: abs(image) } : {}), ...(email ? { email } : {}), ...(sameAs.length ? { sameAs } : {}) }];
---
{card && <aside class="person">
  {image && <img src={image} alt={name} width="72" height="72" loading="lazy" />}
  <div><p class="name"><strong>{name}</strong>{jobTitle && <span> · {jobTitle}</span>}</p>
    {description && <p>{description}</p>}
    {sameAs.length > 0 && <ul>{sameAs.map((s) => <li><a href={s} rel="me noopener" target="_blank">{new URL(s).host.replace(/^www\./, '')}</a></li>)}</ul>}
  </div></aside>}
<JsonLd graph={graph} />
<style>
  .person { display: flex; gap: 14px; align-items: flex-start; border: 1px solid var(--line); border-radius: 8px; padding: 14px; background: var(--surface); margin: 20px 0 }
  .person img { border-radius: 50% } .person p { margin: 0 0 6px } .person ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; flex-wrap: wrap; font-size: .875rem }
</style>
