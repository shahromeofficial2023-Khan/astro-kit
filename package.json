{
  "name": "@shahrome/astro-kit",
  "version": "0.3.3",
  "description": "Shared SEO head, routes, build contract and share-image renderer for the ws12 Astro fleet.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.js"
    },
    "./routes/robots.js": "./routes/robots.js",
    "./routes/llms.js": "./routes/llms.js",
    "./base.css": "./styles/base.css",
    "./Calculator.astro": "./components/Calculator.astro",
    "./Choice.astro": "./components/Choice.astro",
    "./Facts.astro": "./components/Facts.astro",
    "./Faq.astro": "./components/Faq.astro",
    "./Field.astro": "./components/Field.astro",
    "./Head.astro": "./components/Head.astro",
    "./Hero.astro": "./components/Hero.astro",
    "./JsonLd.astro": "./components/JsonLd.astro",
    "./Layout.astro": "./components/Layout.astro",
    "./ResultCard.astro": "./components/ResultCard.astro",
    "./Timeline.astro": "./components/Timeline.astro",
    "./ToolSchema.astro": "./components/ToolSchema.astro",
    "./pages/*": "./pages/*",
    "./pages/legal.mjs": "./pages/legal.mjs"
  },
  "bin": {
    "kit": "./bin/kit.mjs"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "virtual.d.ts",
    "components",
    "routes",
    "styles",
    "client",
    "bin",
    "pages"
  ],
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "sharp": "^0.34.0"
  },
  "types": "./index.d.ts"
}
