---
import Prose from './Prose.astro';
import site from 'virtual:fleet-site';
const contact = site.owner?.email;
---
<Prose title={`Terms of Use | ${site.name}`} description={`The terms for using ${site.name}.`} path="/terms/">
  <h1>Terms of Use</h1>
  {site.legal_date && <p><em>Last updated {site.legal_date}.</em></p>}
  <p>By using {site.name} you agree to these terms.</p>
  <h2>Free to use</h2>
  <p>{site.name} is free for personal and commercial use. You may not copy the site or its code to run as your own.</p>
  <h2>Results are estimates</h2>
  <p>Results depend on the numbers you enter and are provided for general information. Check anything important with a qualified professional before you rely on it.</p>
  <h2>No warranty</h2>
  <p>The site is provided "as is", without any warranty. We are not liable for any loss arising from its use.</p>
  <h2>Links</h2>
  <p>Links to other websites are for convenience. We are not responsible for their content.</p>
  <h2>Changes</h2>
  <p>We may change these terms or the site at any time.</p>
  {contact && <p>Questions: <a href={`mailto:${contact}`}>{contact}</a>.</p>}
</Prose>
